 'use strict';
 
+const MAX_DEPTH = 128;
+
+exports.checkDepth = ast => {
+  const stack = [{ node: ast, depth: 0 }];
+
+  while (stack.length > 0) {
+    const { node, depth } = stack.pop();
+
+    if (depth > MAX_DEPTH) {
+      throw new SyntaxError(`AST depth exceeds maximum nesting depth (${MAX_DEPTH})`);
+    }
+
+    if (node.nodes) {
+      for (const child of node.nodes) {
+        stack.push({ node: child, depth: depth + 1 });
+      }
+    }
+  }
+};
